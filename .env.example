# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.

APP_NAME=Prefa.News
APP_ENV=development
SECRET_KEY=troque-por-um-valor-aleatorio-em-producao
DEBUG=true

# SQLite local. Em produção, considere Postgres, ex.:
# postgresql+psycopg://usuario:senha@host:5432/prefa_news
DATABASE_URL=sqlite:///./data/prefa_news.db

MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

INSTAGRAM_ENABLED=false
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000

NEWS_FETCH_TIMEOUT=15
NEWS_ITEMS_PER_FEED=5
NEWS_MAX_AGE_DAYS_TO_IGNORE_CITY=15
NEWS_MIN_SCORE_TO_REMOVE=-1000

# Cross-city AI insights (Groq)
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
